# Copy to .env.local for local development on the Takeda VPN. Never commit real values.

DB_HOST=
DB_PORT=5442
DB_NAME=
DB_USER=
DB_SSL=require
# DB_SSL_CA_PATH=certs/rds-global-bundle.pem
# DB_POOL_MAX=5

# Password: first match wins.
# 1. Deployed on AWS: Secrets Manager ARN, read with the host's IAM role.
# DB_SECRET_ARN=
# AWS_REGION=us-east-1
# 2. Local development:
DB_PASSWORD=
# 3. Transitional Vercel variable: AWS_SECRET_DEV

# client-asserted (current, not secure) | entra (not implemented yet)
AUTH_PROVIDER=client-asserted
